# Copy to .env.local for local dev; set these in your host's dashboard for deploys.
# Get the values from your Supabase project: Settings -> API.

# Public — safe to expose to the browser
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-only — never commit or expose
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Password for /admin (change before going live!)
ADMIN_PASSWORD=<long-random-string>
